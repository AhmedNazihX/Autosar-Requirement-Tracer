OPENROUTER_API_KEY=
MAX_REPORT_COST_USD=2.0

# The POST /chat token bucket (story S6.3.1). Sustained requests per minute,
# and how many may arrive back to back before the limit binds. Sized for a
# person; a render loop or a held Retry is what these stop.
CHAT_RATE_LIMIT_PER_MINUTE=12
CHAT_RATE_LIMIT_BURST=6

# Which corpus this backend serves — a manifest path relative to backend/
# (also the default the evaluation CLIs use for --manifest). Leave unset for
# the AUTOSAR CAN corpus.
PROJECT_MANIFEST=../projects/autosar-can/project.yaml
