        600.227
      ],
      "char_start": 157895,
      "char_end": 158066,
      "text": "[SWS_Can_CONSTR_00509] ⌈The ECUC partitions referenced by CanControllerE-\ncucPartitionRef shall be a subset of the ECUC partitions referenced by CanEcucParti-\ntionRef.⌋()\n"
    },
    {
      "block_no": 28,
      "bbox": [
        70.866,
        610.392,
        524.415,
        637.089
      ],
      "char_start": 158066,
      "char_end": 158202,
      "text": "[SWS_Can_CONSTR_00510] ⌈CanController and CanTrcvChannel of one communi-\ncation channel shall all reference the same ECUC partition.⌋()\n"
    },
    {
      "block_no": 29,
      "bbox": [
        70.866,
        647.254,
        524.411,
        688.397
      ],
      "char_start": 158202,
