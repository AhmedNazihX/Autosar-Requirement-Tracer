        203.162,
        311.277,
        211.591
      ],
      "char_start": 229166,
      "char_end": 229201,
      "text": "Syntax\nboolean Com_TxIpduCallout (\n"
    },
    {
      "block_no": 6,
      "bbox": [
        182.161,
        212.626,
        301.713,
        239.525
      ],
      "char_start": 229201,
      "char_end": 229244,
      "text": "PduIdType PduId,\nPduInfoType* PduInfoPtr\n)\n"
